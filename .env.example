# Application
APP_NAME=vector-lens-ryan-vo
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/vector_lens
# For local development without Docker, use SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./vector_lens.db

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=vector-lens
KEYCLOAK_CLIENT_ID=vector-lens-frontend
KEYCLOAK_CLIENT_SECRET=change-me-in-production
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_DISCOVERY_URL=http://localhost:8080/realms/vector-lens/.well-known/openid-configuration
OIDC_REDIRECT_URI=http://localhost:5173/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=vector-lens
VITE_KEYCLOAK_CLIENT_ID=vector-lens-frontend

# LLM (optional - for llm-explain feature)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# Embedding model (local, for similarity-search)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu